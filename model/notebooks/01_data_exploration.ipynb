{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Iceberg Drift Prediction - Data Exploration\n",
    "\n",
    "This notebook explores the data pipeline for iceberg drift prediction."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "from pathlib import Path\n",
    "sys.path.insert(0, str(Path(\"..\").resolve() / \"src\"))\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import xarray as xr\n",
    "\n",
    "from iceberg_drift.data_processing import (\n",
    "    download_iceberg_positions,\n",
    "    download_era5_wind,\n",
    "    download_copernicus_currents,\n",
    "    match_environmental_data,\n",
    "    engineer_features,\n",
    "    create_targets,\n",
    "    split_trajectories,\n",
    "    get_feature_columns,\n",
    ")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Generate Synthetic Iceberg Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate synthetic iceberg trajectories\n",
    "iceberg_df = download_iceberg_positions(\n",
    "    output_dir=\"../data/raw\",\n",
    "    start_date=\"2020-01-01\",\n",
    "    end_date=\"2022-12-31\",\n",
    "    min_length_m=100,\n",
    "    source=\"SYNTHETIC\",\n",
    ")\n",
    "\n",
    "print(f\"Shape: {iceberg_df.shape}\")\n",
    "print(f\"Columns: {list(iceberg_df.columns)}\")\n",
    "print(f\"Unique icebergs: {iceberg_df['iceberg_id'].nunique()}\")\n",
    "print(f\"Date range: {iceberg_df['datetime'].min()} to {iceberg_df['datetime'].max()}\")\n",
    "print(f\"Lat range: {iceberg_df['lat'].min():.2f} to {iceberg_df['lat'].max():.2f}\")\n",
    "print(f\"Lon range: {iceberg_df['lon'].min():.2f} to {iceberg_df['lon'].max():.2f}\")\n",
    "print(f\"Length range: {iceberg_df['length_m'].min():.0f} to {iceberg_df['length_m'].max():.0f} m\")\n",
    "\n",
    "iceberg_df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Visualize Iceberg Trajectories"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Plot a few trajectories\n",
    "fig, ax = plt.subplots(figsize=(12, 10))\n",
    "\n",
    "for iceberg_id in iceberg_df['iceberg_id'].unique()[:5]:\n",
    "    traj = iceberg_df[iceberg_df['iceberg_id'] == iceberg_id]\n",
    "    ax.plot(traj['lon'], traj['lat'], '-o', markersize=2, label=iceberg_id)\n",
    "\n",
    "ax.set_xlabel('Longitude')\n",
    "ax.set_ylabel('Latitude')\n",
    "ax.set_title('Synthetic Iceberg Trajectories')\n",
    "ax.legend()\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Generate Environmental Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate synthetic ERA5 wind data\n",
    "wind_ds = download_era5_wind(\n",
    "    output_dir=\"../data/raw\",\n",
    "    start_date=\"2020-01-01\",\n",
    "    end_date=\"2022-12-31\",\n",
    "    bbox=(-180, -80, 180, -50),\n",
    "    variables=[\"u10\", \"v10\", \"msl\"],\n",
    ")\n",
    "\n",
    "print(f\"Wind dataset:\\n{wind_ds}\")\n",
    "\n",
    "# Generate synthetic Copernicus currents\n",
    "current_ds = download_copernicus_currents(\n",
    "    output_dir=\"../data/raw\",\n",
    "    start_date=\"2020-01-01\",\n",
    "    end_date=\"2022-12-31\",\n",
    "    bbox=(-180, -80, 180, -50),\n",
    "    depth_levels=[0, 10, 50, 100, 200],\n",
    "    variables=[\"uo\", \"vo\", \"temperature\", \"salinity\"],\n",
    ")\n",
    "\n",
    "print(f\"\\nCurrent dataset:\\n{current_ds}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Match Environmental Data to Iceberg Positions"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Match wind and currents to iceberg positions\n",
    "matched_df = match_environmental_data(\n",
    "    iceberg_df,\n",
    "    wind_ds,\n",
    "    current_ds,\n",
    "    wind_vars=[\"u10\", \"v10\"],\n",
    "    current_vars=[\"uo\", \"vo\"],\n",
    ")\n",
    "\n",
    "print(f\"Matched shape: {matched_df.shape}\")\n",
    "print(f\"New columns: {[c for c in matched_df.columns if c not in iceberg_df.columns]}\")\n",
    "\n",
    "matched_df.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Feature Engineering"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Engineer features\n",
    "features_df = engineer_features(\n",
    "    matched_df,\n",
    "    add_cyclical_time=True,\n",
    "    add_physics_features=True,\n",
    "    add_lag_features=True,\n",
    "    lag_hours=[6, 12, 24, 48],\n",
    ")\n",
    "\n",
    "print(f\"Features shape: {features_df.shape}\")\n",
    "print(f\"Feature columns ({len(features_df.columns)}):\")\n",
    "for col in sorted(features_df.columns):\n",
    "    print(f\"  {col}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Create Prediction Targets"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create targets for 24-hour prediction\n",
    "targets_df = create_targets(\n",
    "    features_df,\n",
    "    prediction_horizon_hours=24,\n",
    "    target_type=\"velocity\",\n",
    ")\n",
    "\n",
    "print(f\"Targets shape: {targets_df.shape}\")\n",
    "target_cols = [c for c in targets_df.columns if c.startswith('target_')]\n",
    print(f\"Target columns: {target_cols}\")\n",
    "\n",
    "targets_df[target_cols].describe()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Train/Val/Test Split"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Split by trajectories\n",
    "train_df, val_df, test_df = split_trajectories(\n",
    "    targets_df,\n",
    "    train_frac=0.7,\n",
    "    val_frac=0.15,\n",
    "    test_frac=0.15,\n",
    "    random_seed=42,\n",
    "    strategy=\"trajectory\",\n",
    ")\n",
    "\n",
    "print(f\"Train: {len(train_df)} samples, {train_df['iceberg_id'].nunique()} icebergs\")\n",
    "print(f\"Val: {len(val_df)} samples, {val_df['iceberg_id'].nunique()} icebergs\")\n",
    "print(f\"Test: {len(test_df)} samples, {test_df['iceberg_id'].nunique()} icebergs\")\n",
    "\n",
    "# Feature selection\n",
    "feature_cols = get_feature_columns(train_df)\n",
    "target_cols = [c for c in train_df.columns if c.startswith('target_')]\n",
    "\n",
    f\"Features: {len(feature_cols)}, Targets: {len(target_cols)}\""
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Feature Scaling"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from iceberg_drift.data_processing.preprocessing import scale_features\n",
    "\n",
    "train_scaled, val_scaled, test_scaled, scaler = scale_features(\n",
    "    train_df, val_df, test_df, feature_cols, scaler_type=\"standard\"\n",
    ")\n",
    "\n",
    "# Check scaling\n",
    "print(\"Train feature stats (should be ~0 mean, ~1 std):\")\n",
    "print(train_scaled[feature_cols].mean().mean())\n",
    "print(train_scaled[feature_cols].std().mean())"
   ]
  }
 ],
